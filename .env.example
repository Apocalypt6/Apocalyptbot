# Apocalyptbot configuration for unattended (VPS) operation.
# Copy to `.env` and edit. NEVER commit the real .env — it is gitignored.

# --- What to trade -----------------------------------------------------------
STRATEGY=sma_crossover
SYMBOL=BTC-USD
INTERVAL=1h
CASH=10000

# Strategy parameters, space-separated key=value pairs.
#   sma_crossover: fast, slow, allocation
#   rsi:           period, oversold, overbought, allocation
#   dca:           every, amount
STRATEGY_PARAMS=fast=10 slow=30

# How often the bot wakes up to make a decision (seconds). 3600 = hourly.
POLL_SECONDS=3600

# Simulated execution costs.
FEE_RATE=0.005
SLIPPAGE=0.0005

# Where state and heartbeat live (inside the container/workdir).
STATE_PATH=state/portfolio.state.json
HEARTBEAT_PATH=state/heartbeat

# --- Notifications (optional but recommended for a headless VPS) -------------
# Telegram: create a bot via @BotFather, get its token, and your chat id.
APOCALYPTBOT_TELEGRAM_TOKEN=
APOCALYPTBOT_TELEGRAM_CHAT_ID=
# ...or a Discord/Slack incoming webhook URL:
APOCALYPTBOT_WEBHOOK_URL=

# --- Exchange API keys (ONLY needed once live trading exists) ----------------
# LEAVE BLANK for paper trading. When you do go live:
#   * create keys scoped to TRADE ONLY — never enable withdrawals
#   * enable IP whitelisting on the exchange, pinned to this VPS's IP
APOCALYPTBOT_API_KEY=
APOCALYPTBOT_API_SECRET=
