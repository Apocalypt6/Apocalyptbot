# Copy to `.env` and edit. NEVER commit the real file.

# hunt = watch the CLOB and print opportunities
# paper = simulated pUSD against live books
# live is NOT accepted by deploy/run.sh. Do not put it here.
MODE=hunt
STRATEGY=completeness
# Optional, space-separated key=value pairs expanded to --param by deploy/run.sh
# STRATEGY_PARAMS=limit=3
CASH=1000
POLL_SECONDS=30
HUNT_LIMIT=40
MIN_EDGE=0.008
MIN_SHARES=20
MAX_NOTIONAL=50
MAX_EXPOSURE=500
MAX_DAILY_LOSS=75

STATE_PATH=state/portfolio.state.json
HEARTBEAT_PATH=state/heartbeat

# Optional alerts
APOCALYPTBOT_TELEGRAM_TOKEN=
APOCALYPTBOT_TELEGRAM_CHAT_ID=
APOCALYPTBOT_WEBHOOK_URL=

# Live CLOB — leave blank. The service unit never runs `live`.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=0

# Leave EXA_API_KEY blank. Research is off.
# Hunt uses Polymarket's free APIs. Paid search (~$7/1k Instant queries)
# is not wired into the default loop — do not burn a $16 free-tier balance.
EXA_API_KEY=
