# systemd unit for Apocalyptbot — hunt or paper only.
#
#   sudo cp deploy/systemd/apocalyptbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now apocalyptbot
#   journalctl -u apocalyptbot -f
#
# deploy/run.sh reads MODE from .env and will refuse MODE=live.
# Do not replace ExecStart with `python -m apocalyptbot live`.

[Unit]
Description=Apocalyptbot Polymarket hunter (paper/hunt only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apocalypt
Group=apocalypt
WorkingDirectory=/opt/apocalyptbot
EnvironmentFile=/opt/apocalyptbot/.env
ExecStart=/opt/apocalyptbot/deploy/run.sh
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apocalyptbot/state /opt/apocalyptbot/logs /opt/apocalyptbot/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
