# Copy to /etc/pulse5m.env or .env on the VPS. NEVER commit the live copy.
PULSE_MODE=paper
PULSE_STRATEGY=lock
PULSE_FRAMES=5m,15m
PULSE_SCRIPTS=arb,lock,snipe,hedge
PULSE_ASSETS=btc,eth,sol,xrp
PULSE_SIZE_USD=10
PULSE_BANKROLL=200
PULSE_KELLY=0.25
PULSE_MIN_ASK=0.50
PULSE_MAX_ASK=0.92
PULSE_MIN_EDGE=0.08
PULSE_MIN_EV=0.03
PULSE_MAX_EDGE=0.45
PULSE_ENTRY_FROM=60
PULSE_ENTRY_TO=3
PULSE_MAX_SPREAD=0.08
PULSE_ENABLE_ARB=true
PULSE_REQUIRE_MAX_TIER=false
PULSE_PERSIST_TICKS=2
PULSE_DAILY_LOSS_HALT=50
PULSE_MAX_LOSSES=6
PULSE_DUMP_CENTS=0.12
PULSE_DUMP_WINDOW=3
PULSE_MAX_HEDGE_PAIR=1.02
PULSE_SNIPE_MAX_ASK=0.96
PULSE_PORT=8080
PULSE_DATA=/var/lib/pulse5m
PULSE_LOG=INFO
